{
  "name": "@pi-switch/pi-codex-app-server",
  "version": "0.2.0",
  "description": "Expose Pi Coding Agent through the Codex App Server and ChatGPT Remote protocols.",
  "keywords": [
    "app-server",
    "chatgpt-remote",
    "codex",
    "pi-coding-agent",
    "pi-package"
  ],
  "homepage": "https://github.com/AdamsGH/pi-codex-app-server#readme",
  "bugs": {
    "url": "https://github.com/AdamsGH/pi-codex-app-server/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamsGH/pi-codex-app-server.git"
  },
  "bin": {
    "pi-codex-app-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "drizzle",
    "src",
    "vendor/openai-codex-app-server-protocol",
    "README.md",
    "docs",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "check": "ultracite check",
    "db:generate": "drizzle-kit generate --output json",
    "fix": "ultracite fix",
    "protocol:sync": "bun run ./scripts/sync-codex-protocol.ts",
    "sidebar": "bun run ./scripts/sync-codex-sidebar.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run verify",
    "package:check": "bun run ./scripts/check-package.ts",
    "verify": "bun run check && bun run typecheck && bun run test && bun run build && bun run package:check",
    "acceptance:sidebar": "node scripts/check-desktop-sidebar.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@logtape/logtape": "^2.3.2",
    "@logtape/redaction": "^2.3.2",
    "ajv": "^8.17.1",
    "commander": "^15.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "es-toolkit": "^1.39.10",
    "json-rpc-2.0": "^1.7.1",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/bun": "^1.2.21",
    "@types/node": "^24.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "1.0.0-rc.4",
    "husky": "^9.1.7",
    "json-schema-faker": "^0.6.3",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^5.9.2",
    "ultracite": "7.10.6",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@earendil-works/chord": "~1.1.0",
    "@earendil-works/pi-agent-core": "~1.1.0",
    "@earendil-works/pi-ai": "~1.1.0",
    "@earendil-works/pi-codemode": "~1.1.0",
    "@earendil-works/pi-coding-agent": "~1.1.0",
    "@earendil-works/pi-mcp": "~1.1.0",
    "@earendil-works/pi-telemetry": "~1.1.0",
    "@earendil-works/pi-tui": "~1.1.0"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.3",
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  }
}
